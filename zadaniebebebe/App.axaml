<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="zadaniebebebe.App"
             RequestedThemeVariant="Light">

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="BgBrush">#F4F5F9</SolidColorBrush>
          <SolidColorBrush x:Key="SidebarBrush">#FFFFFF</SolidColorBrush>
          <SolidColorBrush x:Key="CardBrush">#FFFFFF</SolidColorBrush>
          <SolidColorBrush x:Key="LineBrush">#E8E9F0</SolidColorBrush>
          <SolidColorBrush x:Key="TextBrush">#1C1D2B</SolidColorBrush>
          <SolidColorBrush x:Key="MutedBrush">#8A8DA3</SolidColorBrush>
          <SolidColorBrush x:Key="AccentSoftBrush">#EDE9FD</SolidColorBrush>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="BgBrush">#0E0F14</SolidColorBrush>
          <SolidColorBrush x:Key="SidebarBrush">#14151C</SolidColorBrush>
          <SolidColorBrush x:Key="CardBrush">#1A1B24</SolidColorBrush>
          <SolidColorBrush x:Key="LineBrush">#262833</SolidColorBrush>
          <SolidColorBrush x:Key="TextBrush">#F2F3F8</SolidColorBrush>
          <SolidColorBrush x:Key="MutedBrush">#7C8096</SolidColorBrush>
          <SolidColorBrush x:Key="AccentSoftBrush">#2A2447</SolidColorBrush>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />

    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="18"/>
      <Setter Property="Margin" Value="0,0,12,12"/>
    </Style>
    <Style Selector="TextBlock.muted"><Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/><Setter Property="FontSize" Value="12"/></Style>
    <Style Selector="TextBlock.h1"><Setter Property="FontSize" Value="20"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,16"/></Style>
    <Style Selector="TextBlock.big"><Setter Property="FontSize" Value="28"/><Setter Property="FontWeight" Value="SemiBold"/></Style>

    <Style Selector="Border.chip"><Setter Property="CornerRadius" Value="6"/><Setter Property="Padding" Value="8,2"/><Setter Property="HorizontalAlignment" Value="Left"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
    <Style Selector="Border.chip > TextBlock"><Setter Property="FontSize" Value="11"/></Style>
    <Style Selector="Border.design"><Setter Property="Background" Value="#266D4FE8"/></Style>
    <Style Selector="Border.design > TextBlock"><Setter Property="Foreground" Value="#8B73F0"/></Style>
    <Style Selector="Border.dev"><Setter Property="Background" Value="#263B82F6"/></Style>
    <Style Selector="Border.dev > TextBlock"><Setter Property="Foreground" Value="#4F8DF7"/></Style>
    <Style Selector="Border.mkt"><Setter Property="Background" Value="#2622C55E"/></Style>
    <Style Selector="Border.mkt > TextBlock"><Setter Property="Foreground" Value="#2FB464"/></Style>

    <Style Selector="Button.primary"><Setter Property="Background" Value="#5B45D6"/><Setter Property="Foreground" Value="White"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="16,10"/></Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="#4A36B8"/><Setter Property="TextElement.Foreground" Value="White"/></Style>

    <Style Selector="Button.nav">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Padding" Value="12,10"/>
      <Setter Property="Margin" Value="0,0,0,4"/>
      <Setter Property="CornerRadius" Value="8"/>
    </Style>
    <Style Selector="Button.nav:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
    </Style>
    <Style Selector="Button.nav.active /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#5B45D6"/>
      <Setter Property="TextElement.Foreground" Value="White"/>
    </Style>
  </Application.Styles>
</Application>
