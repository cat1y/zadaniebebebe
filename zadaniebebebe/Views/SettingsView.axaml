<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="zadaniebebebe.SettingsView">
  <StackPanel Margin="24,20,12,8">
    <TextBlock Classes="h1" Text="Настройки"/>
    <Border Classes="card" MaxWidth="500" HorizontalAlignment="Left">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel><TextBlock Text="Тёмная тема"/><TextBlock Classes="muted" Text="Переключение светлой и тёмной темы"/></StackPanel>
        <ToggleSwitch x:Name="ThemeSwitch" Grid.Column="1" OnContent="" OffContent=""/>
      </Grid>
    </Border>
  </StackPanel>
</UserControl>
